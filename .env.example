# Copier en .env (dev local) — en déploiement, .env est produit par `sops -d .env.enc`
# Aucun secret réel ici : valeurs de développement uniquement.

GROUP_ID=G9                        # numéro de consortium : RESILIENCE-G9, Workshop2026-M2-G9
HOST_IP=192.168.137.1              # IP du PC Hôte sur le hotspot
SHARED_NAT_IPS=192.168.65.1        # Docker Desktop présente toutes les connexions publiées avec cette adresse : étranglée, pas bloquée

POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=change-me-postgres

JWT_SECRET=change-me-32-bytes-minimum-please-really
DEMO_PASSWORD=demo1234             # mot de passe des comptes de démo (alice, bob, carol, sim1..5)
VERIFIER_PASSWORD=change-me-verifier

GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Back-office à authentification renforcée (consigne additionnelle 1)
BACKOFFICE_SECRET=change-me-32-bytes-minimum-for-cookies
BACKOFFICE_ADMIN_LOGIN=admin
BACKOFFICE_ADMIN_PASSWORD=change-me-backoffice
AGENT_URL=http://host.docker.internal:8090   # agent caméra sur le PC Hôte (Windows, hors Docker) ; tests : http://mockagent:8090
AGENT_TOKEN=change-me-agent-token            # même valeur côté agent (faceauth/agent)
AGENT_MOCK_RESULT=recognized                 # profil mockagent : recognized | unknown | timeout
CAMERA_MODE=browser                          # browser : webcam du navigateur, back-office ouvert sur http://localhost/admin/ (PC Hôte) · server : webcam ouverte par l'agent

SIM_RATE=3                         # transactions/s du trafic normal
DETECTOR_DRY_RUN=false             # true = le détecteur logue sans déclencher la remédiation
LLM_MODEL=qwen3:8b                 # 8,2 Md — exception validée par les coachs le 19/10 ; sur le PC IA de délestage (cf. README)
EMBED_MODEL=embeddinggemma         # index en mémoire : un restart de l'assistant suffit après changement
OLLAMA_URL=http://ollama:11434     # PC de délestage IA : http://<ip-du-pc-ia>:11434 — sur un hotspot de téléphone, relever son IP le jour J (elle peut changer)

# Liaison des ports publiés. 0.0.0.0 = joignable depuis le PC Attaquant (requis pour edge et dashboard)
EDGE_BIND=0.0.0.0
DASHBOARD_BIND=0.0.0.0
DASHBOARD_PORT=3000                # changer si le port est déjà pris sur le poste
