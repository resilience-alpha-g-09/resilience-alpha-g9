{
 "uid": "ra-plateforme",
 "title": "RESILIENCE-ALPHA — Plateforme",
 "tags": [
  "resilience-alpha"
 ],
 "timezone": "browser",
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "schemaVersion": 39,
 "version": 1,
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "API",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red"
        },
        "1": {
         "text": "UP",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up{job=\"api\"}"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Auth",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red"
        },
        "1": {
         "text": "UP",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up{job=\"auth\"}"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Remédiateur — état",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "IDLE",
         "color": "green"
        },
        "1": {
         "text": "DETECTED",
         "color": "orange"
        },
        "2": {
         "text": "MITIGATING",
         "color": "red"
        },
        "3": {
         "text": "VERIFYING",
         "color": "yellow"
        },
        "4": {
         "text": "RECOVERED",
         "color": "green"
        },
        "5": {
         "text": "FAILED",
         "color": "dark-red"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "remediator_state"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Dernier MTTR",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 13,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 40
       },
       {
        "color": "red",
        "value": 60
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "remediator_last_mttr_seconds"
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Score anomalie",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 17,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "detector_anomaly_score"
    }
   ]
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Incidents",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 21,
    "y": 0,
    "w": 3,
    "h": 4
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(remediator_incidents_total) or vector(0)"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Transactions / s (API)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_requests_total{job=\"api\",handler=\"/transactions\",method=\"POST\"}[30s]))",
     "legendFormat": "POST /transactions"
    },
    {
     "refId": "B",
     "expr": "sum(rate(http_requests_total{job=\"api\"}[30s]))",
     "legendFormat": "toutes requêtes API"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Latence p95 (API)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"api\"}[30s])))",
     "legendFormat": "p95 api"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"auth\"}[30s])))",
     "legendFormat": "p95 auth"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Taux d'erreur (API)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 12,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_requests_total{job=\"api\",status=~\"5..\"}[30s])) / clamp_min(sum(rate(http_requests_total{job=\"api\"}[30s])),0.001)",
     "legendFormat": "5xx"
    },
    {
     "refId": "B",
     "expr": "sum(rate(http_requests_total{job=\"api\",status=~\"4..\"}[30s])) / clamp_min(sum(rate(http_requests_total{job=\"api\"}[30s])),0.001)",
     "legendFormat": "4xx"
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Simulateur — succès des paiements",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 11,
    "w": 12,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(sim_requests_total{outcome=\"ok\"}[30s])) / clamp_min(sum(rate(sim_requests_total[30s])),0.001)",
     "legendFormat": "taux de succès"
    }
   ]
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "CPU par service",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 12,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (job) (rate(process_cpu_seconds_total{job=~\"api|auth|remediator|detector\"}[30s]))",
     "legendFormat": "{{job}} (process)"
    },
    {
     "refId": "B",
     "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"ra-.*\"}[30s]))",
     "legendFormat": "{{name}} (cadvisor)"
    }
   ]
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "Score d'anomalie (IsolationForest)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 18,
    "w": 12,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "detector_anomaly_score",
     "legendFormat": "score"
    },
    {
     "refId": "B",
     "expr": "detector_threshold",
     "legendFormat": "seuil"
    }
   ]
  },
  {
   "id": 20,
   "type": "logs",
   "title": "Événements du remédiateur",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 25,
    "w": 12,
    "h": 9
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{container=\"remediator\"} |= \"event\""
    }
   ]
  },
  {
   "id": 21,
   "type": "logs",
   "title": "WAF — requêtes bloquées (403)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 25,
    "w": 12,
    "h": 9
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{container=\"edge\"} | json | status = 403"
    }
   ]
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 }
}