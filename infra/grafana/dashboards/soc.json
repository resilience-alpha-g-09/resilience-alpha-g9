   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (count_over_time({container=\"edge\"} | json | __error__=\"\" [30s]))",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Échecs d'authentification",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
