# Agent SIMULÉ (sans caméra ni OpenCV) pour les tests et la CI : docker compose --profile mockagent up -d
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 AGENT_MOCK=1
WORKDIR /app
COPY requirements-mock.txt .
RUN pip install -r requirements-mock.txt
COPY agent.py .
RUN useradd --system --uid 10001 --create-home appuser && mkdir -p /app/data /app/model && chown -R appuser /app
USER appuser
EXPOSE 8090
CMD ["python", "agent.py", "serve"]
